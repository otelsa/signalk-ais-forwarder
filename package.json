{
  "name": "signalk-ais-forwarder",
  "version": "1.2.0",
  "description": "Forwards received AIS targets (and optionally raw AIVDM/AIVDO traffic) from Signal K to UDP endpoints such as MarineTraffic or AISHub roaming stations, with a status webapp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Alexander Pilarczyk <alexander@pilarczyk.de>",
  "contributors": [
    {
      "name": "Harri Kapanen",
      "url": "https://github.com/hkapanen/ais-forwarder"
    },
    {
      "name": "Teppo Kurki",
      "url": "https://github.com/SignalK/aisreporter"
    },
    {
      "name": "Scott Bender"
    },
    {
      "name": "Ilker Temir"
    }
  ],
  "license": "Apache-2.0",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-ais",
    "signalk-category-nmea-0183",
    "ais",
    "marinetraffic",
    "aishub",
    "roaming-station"
  ],
  "engines": {
    "node": ">=18"
  },
  "signalk": {
    "appIcon": "app-icon.svg",
    "displayName": "AIS Forwarder"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "coverage": "c8 --reporter=text --reporter=lcov npm test",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "format": "npm run prettier",
    "prepublishOnly": "npm run build"
  },
  "c8": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.d.ts",
      "test/**",
      "coverage/**",
      "dist/**"
    ],
    "all": true,
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "ggencoder": "^1.0.10"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.31.1",
    "@types/chai": "^5.2.3",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "c8": "^12.0.0",
    "chai": "^5.2.2",
    "mocha": "^11.7.5",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
